# Google Chat incoming webhook URL (Space > Apps & integrations > Webhooks)
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=XXXX&token=XXXX

# "/" is always monitored by default. Add extra host paths to watch here (comma-separated).
EXTRA_FILESYSTEM=/home,/var

# Default alert threshold in percent, used when no per-disk override matches
DISK_THRESHOLD_PERCENT=80

# Optional per-disk threshold overrides as a JSON object, e.g. {"/": 90, "/var": 75}
DISK_THRESHOLD_OVERRIDES={}

# How often (in seconds) to check disk usage
CHECK_INTERVAL_SECONDS=60

# Cron expression controlling how often reminders are sent while an alert stays
# unresolved (standard 5-field cron). Example: "0 * * * *" = every hour.
# Leave empty to disable reminders.
REMINDER_CRON=0 * * * *

# Label used to identify this server in alert messages (defaults to container hostname)
HOSTNAME_LABEL=

# Path where the host filesystem is bind-mounted inside the container (see docker-compose.yml)
HOST_MOUNT_PREFIX=/hostfs

# Send a one-time confirmation message to Google Chat on startup (true/false)
SEND_STARTUP_MESSAGE=true
